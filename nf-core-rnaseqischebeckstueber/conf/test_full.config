/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/rnaseqischebeckstueber -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/
process {
    resourceLimits = [
        cpus: 8,
        memory: '16.GB',
        time: '12.h'
    ]

    withName: 'SALMON_INDEX' {
        cpus = 4
        memory = '16.GB'
    }
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Two complete mouse RNA-seq samples'

    // Input data for full size test
    input = "${projectDir}/test_samplesheet_full.csv"

    // Genome references
    genome = 'GRCm38'

    skip_ribodetector = true
}