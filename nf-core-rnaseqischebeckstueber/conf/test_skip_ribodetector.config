/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests without RiboDetector
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Skips rRNA removal with RiboDetector.

    Use as follows:
        nextflow run . -profile test_skip_ribodetector,docker --outdir results_test_skip_ribo

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '16.GB',
        time: '2.h'
    ]

    withName: 'SALMON_INDEX' {
        cpus = 4
        memory = '16.GB'
    }
}

params {
    config_profile_name = 'Test profile without RiboDetector'
    config_profile_description = 'Minimal nf-core RNA-seq test dataset without rRNA removal'

    input = "${projectDir}/assets/test_samplesheet_tiny.csv"

    fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/626c8fab639062eade4b10747e919341cbf9b41a/reference/genome.fasta'
    gtf = 'https://raw.githubusercontent.com/nf-core/test-datasets/626c8fab639062eade4b10747e919341cbf9b41a/reference/genes_with_empty_tid.gtf.gz'

    skip_ribodetector = true
}
