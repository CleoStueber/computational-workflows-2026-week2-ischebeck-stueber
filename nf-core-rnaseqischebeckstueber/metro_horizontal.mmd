        %% QUANTIFICATION
        salmon_quant -->|genes| tx2gene
        tx2gene -->|genes| tximport
        tximport -->|genes| abundance
        abundance -->|genes| multiqc

        %% QUALITY CONTROL
        cat_fastq -->|qc| qc_raw
        fastp -->|qc| qc_trim
        ribo -->|qc| qc_filtered

        qc_raw -->|qc| qc_trim
        qc_trim -->|qc| qc_filtered
        qc_filtered -->|qc| multiqc

