graph LR

    subgraph pipeline [RNA-seq workflow]

        raw[ ]
        cat_fastq[CAT_FASTQ]

        %% STEP 1: PREPROCESSING
        fastp[fastp]
        ribo[RiboDetector]

        qc_raw[FastQC raw]
        qc_trim[FastQC trimmed]
